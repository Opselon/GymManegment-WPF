# Normalise every text file to LF in the repository and check it out with LF on
# every platform. This matches .editorconfig's "end_of_line = lf", so
# `dotnet format` sees identical bytes on Windows and on the CI runner.
* text=auto eol=lf

*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.xlsx binary
