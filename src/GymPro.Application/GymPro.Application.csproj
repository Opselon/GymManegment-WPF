<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Use-case layer. Depends only on Domain plus the abstraction-only slice of
    Microsoft.Extensions (DI/Logging contracts). Never on EF Core or WPF.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GymPro.Application</RootNamespace>
    <AssemblyName>GymPro.Application</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GymPro.Domain\GymPro.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="11.10.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>