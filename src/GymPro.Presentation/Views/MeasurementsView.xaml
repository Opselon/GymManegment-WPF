<UserControl x:Class="GymPro.Presentation.Views.MeasurementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{StaticResource SurfaceBrush}">
    <Grid Margin="24,20,24,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="اندازه‌گیری"
                   Style="{StaticResource HeadingText}"
                   HorizontalAlignment="Left" Margin="0,0,0,16" />

        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="ثبت اندازه جدید" Style="{StaticResource CardTitle}"
                           Margin="0,0,0,14" />

                <TextBlock Text="عضو" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Members}"
                          SelectedItem="{Binding SelectedMember, Mode=TwoWay}"
                          DisplayMemberPath="FullName" Margin="0,0,0,12" />

                <TextBlock Text="دور سینه (سانتی‌متر)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding ChestCm, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,10" />

                <TextBlock Text="دور بازو (سانتی‌متر)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding ArmCm, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,10" />

                <TextBlock Text="دور کمر (سانتی‌متر)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding WaistCm, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,10" />

                <TextBlock Text="قد (سانتی‌متر)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding HeightCm, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,10" />

                <TextBlock Text="وزن (کیلوگرم)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding WeightKg, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,16" />

                <Button Content="ثبت اندازه‌گیری" Command="{Binding SaveCommand}" Height="40" />

                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BannerInfo}"
                           TextWrapping="Wrap" Margin="0,10,0,0" />
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource BannerError}"
                           TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Padding="6"
                Margin="16,0,0,0">
            <Grid>
                <DataGrid ItemsSource="{Binding Measurements}"
                          EnableRowVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="تاریخ" Binding="{Binding MeasuredOn}" Width="120" />
                        <DataGridTextColumn Header="سینه" Binding="{Binding ChestCm}" Width="80" />
                        <DataGridTextColumn Header="بازو" Binding="{Binding ArmCm}" Width="80" />
                        <DataGridTextColumn Header="کمر" Binding="{Binding WaistCm}" Width="80" />
                        <DataGridTextColumn Header="قد" Binding="{Binding HeightCm}" Width="80" />
                        <DataGridTextColumn Header="وزن" Binding="{Binding WeightKg}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="برای دیدن سابقه، یک عضو انتخاب کنید."
                           Style="{StaticResource EmptyStateText}"
                           Visibility="{Binding Measurements.Count, Converter={StaticResource ZeroToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
