<UserControl x:Class="GymPro.Presentation.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{StaticResource SurfaceBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <Grid Margin="0,0,0,18">
                <TextBlock Text="داشبورد" Style="{StaticResource HeadingText}"
                           HorizontalAlignment="Left" VerticalAlignment="Center" />
                <Button Content="به‌روزرسانی" Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <!-- One card shape for every number on this screen: big value,
                 caption underneath. Mixed shapes read as accidental. -->
            <UniformGrid Columns="3" Margin="0,0,0,18">
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="{Binding ActiveMembers, StringFormat={}{0:N0}}"
                                   Style="{StaticResource StatValue}" />
                        <TextBlock Text="اعضای فعال" Style="{StaticResource MutedText}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="{Binding ExpiringThisMonth, StringFormat={}{0:N0}}"
                                   Style="{StaticResource StatValue}" />
                        <TextBlock Text="انقضا در این ماه" Style="{StaticResource MutedText}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding OutstandingTotalRial, StringFormat={}{0:N0}}"
                                   Style="{StaticResource StatValue}" />
                        <TextBlock Text="مانده بدهی (ریال)" Style="{StaticResource MutedText}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Money row: collected against owed. Two cards in three columns
                 leaves a hole, so the third cell carries the member total. -->
            <UniformGrid Columns="3">
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="{Binding CollectedThisMonthRial, StringFormat={}{0:N0}}"
                                   Style="{StaticResource StatValue}" />
                        <TextBlock Text="درآمد این ماه (ریال)" Style="{StaticResource MutedText}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="{Binding TotalMembers, StringFormat={}{0:N0}}"
                                   Style="{StaticResource StatValue}" />
                        <TextBlock Text="کل اعضا" Style="{StaticResource MutedText}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- Debt per member: shows whether the total is spread thin or
                     concentrated in a couple of accounts. -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding AverageOutstandingRial, StringFormat={}{0:N0}}"
                                   Style="{StaticResource StatValue}" />
                        <TextBlock Text="میانگین بدهی هر عضو (ریال)" Style="{StaticResource MutedText}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource BannerError}"
                       TextWrapping="Wrap" Margin="0,0,0,8" />

            <!-- Recent activity. The desk's day at a glance: who came in, when.
                 Bounded to the eight most recent rows so the card stays a card. -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="ورودهای اخیر" Style="{StaticResource CardTitle}"
                               Margin="0,0,0,10" />
                    <DataGrid ItemsSource="{Binding RecentCheckIns}"
                              MaxHeight="320" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="عضو" Binding="{Binding MemberName}" Width="*" />
                            <DataGridTextColumn Header="تاریخ ورود" Binding="{Binding CheckedInOn}" Width="160" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="هنوز ورودی ثبت نشده است."
                               Style="{StaticResource EmptyStateText}"
                               Margin="0,10,0,0"
                               Visibility="{Binding RecentCheckIns.Count, Converter={StaticResource ZeroToVisibility}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
