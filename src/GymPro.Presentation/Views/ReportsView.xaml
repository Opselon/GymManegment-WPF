<UserControl x:Class="GymPro.Presentation.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <StackPanel Margin="28">
        <TextBlock Text="گزارش‌ها" Style="{StaticResource HeadingText}" Margin="0,0,0,20" />

        <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="20"
                MaxWidth="620" HorizontalAlignment="Right">
            <StackPanel>
                <TextBlock Text="خروجی اکسل اعضا" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBlock Text="نام، کد ملی، تلفن، وضعیت، تاریخ شروع و پایان، شهریه و مانده بدهی."
                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,16" />

                <Button Content="ساخت و ذخیره فایل" Command="{Binding ExportMembersCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                        Width="180" HorizontalAlignment="Right" />
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentBrush}"
                   TextWrapping="Wrap" Margin="0,16,0,0" />
        <TextBlock Text="{Binding LastExportPath}" Style="{StaticResource MutedText}"
                   TextWrapping="Wrap" Margin="0,4,0,0" />
        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap" Margin="0,8,0,0" />
    </StackPanel>
</UserControl>
