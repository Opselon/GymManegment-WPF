<Window x:Class="GymPro.Presentation.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GymPro"
        Height="760" Width="1220"
        MinHeight="560" MinWidth="920"
        Background="{StaticResource SurfaceBrush}"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceRaisedBrush}" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="GymPro" Style="{StaticResource HeadingText}" />
                    <TextBlock Text="  |  باشگاه ورزشی" Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>

                <!-- Menu stays hidden until sign-in, so the login screen has no navigation. -->
                <StackPanel x:Name="MenuBar" Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Button Content="داشبورد" Click="OnDashboardClick" Style="{StaticResource MenuButton}" />
                    <Button Content="اعضا" Click="OnMembersClick" Style="{StaticResource MenuButton}" />
                    <Button Content="ورود و خروج" Click="OnAttendanceClick" Style="{StaticResource MenuButton}" />
                    <Button Content="گزارش‌ها" Click="OnReportsClick" Style="{StaticResource MenuButton}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="SignedInAs" Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Text="v2.0" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl Grid.Row="1" x:Name="NavHost" />
    </Grid>
</Window>
