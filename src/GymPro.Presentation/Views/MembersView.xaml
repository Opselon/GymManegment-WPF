<UserControl x:Class="GymPro.Presentation.Views.MembersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="اعضا" Style="{StaticResource HeadingText}" Margin="0,0,0,16" />

        <Border Grid.Row="1" Background="{StaticResource SurfaceRaisedBrush}"
                CornerRadius="10" Padding="18" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="نام کامل" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <TextBox Width="180" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="کد ملی" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <TextBox Width="150" Text="{Binding NationalCode, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="مدت (ماه)" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <TextBox Width="90" Text="{Binding DurationMonths}" />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="شهریه ماهانه (ریال)" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <TextBox Width="150" Text="{Binding MonthlyFeeRial}" />
                </StackPanel>
                <Button Content="ثبت عضو" Command="{Binding RegisterCommand}"
                        VerticalAlignment="Bottom" Height="34" Margin="0,0,0,0" />
                <Button Content="به‌روزرسانی" Command="{Binding RefreshCommand}"
                        VerticalAlignment="Bottom" Height="34" Margin="10,0,0,0" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}"
                   Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />

        <DataGrid Grid.Row="2" ItemsSource="{Binding Members}" Margin="0,24,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="نام" Binding="{Binding FullName}" Width="*" />
                <DataGridTextColumn Header="کد ملی" Binding="{Binding NationalCode}" Width="130" />
                <DataGridTextColumn Header="تلفن" Binding="{Binding PhoneNumber}" Width="130" />
                <DataGridTextColumn Header="شروع" Binding="{Binding StartDate}" Width="120" />
                <DataGridTextColumn Header="پایان" Binding="{Binding EndDate}" Width="120" />
                <DataGridTextColumn Header="بدهی (ریال)" Binding="{Binding OutstandingRial}" Width="140" />
                <DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="110" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
