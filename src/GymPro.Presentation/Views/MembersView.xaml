<UserControl x:Class="GymPro.Presentation.Views.MembersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{StaticResource SurfaceBrush}">
    <Grid Margin="24,20,24,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="330" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,16">
            <TextBlock Text="اعضا" Style="{StaticResource HeadingText}"
                       HorizontalAlignment="Left" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Width="230" Margin="0,0,10,0" />
                <Button Content="جستجو" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Padding="6">
            <Grid>
                <DataGrid x:Name="MembersGrid" ItemsSource="{Binding Members}"
                          EnableRowVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="نام و نام خانوادگی" Binding="{Binding FullName}" Width="*" />
                        <DataGridTextColumn Header="کد ملی" Binding="{Binding NationalCode}" Width="130" />
                        <DataGridTextColumn Header="تماس" Binding="{Binding PhoneNumber}" Width="130" />
                        <DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="عضوی ثبت نشده است. از فرم کنار، اولین عضو را اضافه کنید."
                           Style="{StaticResource EmptyStateText}"
                           Visibility="{Binding Members.Count, Converter={StaticResource ZeroToVisibility}}" />
            </Grid>
        </Border>

        <!-- Registration form. Always visible beside the list so registering a
             walk-in needs no modal round trip. -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}"
                Margin="16,0,0,0" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="ثبت عضو جدید" Style="{StaticResource CardTitle}"
                           Margin="0,0,0,14" />

                <TextBlock Text="نام و نام خانوادگی" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,10" />

                <TextBlock Text="کد ملی (۱۰ رقم)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding NationalCode, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,10" MaxLength="10" />

                <TextBlock Text="شماره تماس" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,10" />

                <TextBlock Text="مدت عضویت (ماه)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding DurationMonths, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,10" />

                <TextBlock Text="شهریه ماهانه (ریال)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding MonthlyFeeRial, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,10" />

                <CheckBox Content="عضو خانم است" IsChecked="{Binding IsFemale}"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          FontFamily="{StaticResource AppFont}"
                          Margin="0,0,0,16" />

                <Button Content="ثبت عضو" Command="{Binding RegisterCommand}" Height="40" />

                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource BannerError}"
                           TextWrapping="Wrap" Margin="0,10,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
