<UserControl x:Class="GymPro.Presentation.Views.AttendanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="ورود و خروج" Style="{StaticResource HeadingText}" />
            <TextBlock Text="{Binding CheckedInToday, StringFormat='امروز: {0} نفر'}"
                       Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="16,0,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource SurfaceRaisedBrush}"
                CornerRadius="10" Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="عضو را انتخاب کنید" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding Members}"
                              SelectedItem="{Binding SelectedMember}"
                              DisplayMemberPath="FullName"
                              Height="34" />
                </StackPanel>

                <Button Grid.Column="1" Content="ثبت ورود" Command="{Binding CheckInCommand}"
                        Height="34" VerticalAlignment="Bottom" Margin="12,0,0,0" MinWidth="110" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="2">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,8" />

            <DataGrid ItemsSource="{Binding CheckIns}" Height="380">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="عضو" Binding="{Binding MemberName}" Width="*" />
                    <DataGridTextColumn Header="تاریخ" Binding="{Binding CheckedInOn}" Width="160" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</UserControl>
