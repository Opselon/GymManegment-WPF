<UserControl x:Class="GymPro.Presentation.Views.AttendanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{StaticResource SurfaceBrush}">
    <Grid Margin="24,20,24,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,16">
            <TextBlock Text="ورود و خروج" Style="{StaticResource HeadingText}"
                       HorizontalAlignment="Left" VerticalAlignment="Center" />
            <Border Background="{StaticResource SurfaceRaisedBrush}"
                    CornerRadius="{StaticResource ControlRadius}" Padding="16,8"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding CheckedInToday, StringFormat={}{0:N0}}"
                               Style="{StaticResource StatValue}" FontSize="20"
                               Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text=" ورود امروز" VerticalAlignment="Center"
                               Style="{StaticResource MutedText}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Check-in panel: pick, confirm, done. -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Stretch">
            <StackPanel>
                <TextBlock Text="ثبت ورود" Style="{StaticResource CardTitle}" Margin="0,0,0,14" />

                <TextBlock Text="انتخاب عضو" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="MemberPicker"
                          ItemsSource="{Binding Members}"
                          SelectedItem="{Binding SelectedMember, Mode=TwoWay}"
                          DisplayMemberPath="FullName"
                          Margin="0,0,0,16" />

                <Button Content="ثبت ورود" Command="{Binding CheckInCommand}" Height="42" />

                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BannerInfo}"
                           TextWrapping="Wrap" Margin="0,12,0,0" />
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource BannerError}"
                           TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Padding="6"
                Margin="16,0,0,0">
            <Grid>
                <DataGrid x:Name="CheckInsGrid" ItemsSource="{Binding CheckIns}"
                          EnableRowVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="عضو" Binding="{Binding MemberName}" Width="*" />
                        <DataGridTextColumn Header="تاریخ ورود" Binding="{Binding CheckedInOn}" Width="140" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="امروز هنوز ورودی ثبت نشده است."
                           Style="{StaticResource EmptyStateText}"
                           Visibility="{Binding CheckIns.Count, Converter={StaticResource ZeroToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
