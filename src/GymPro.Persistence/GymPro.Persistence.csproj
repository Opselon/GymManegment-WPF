<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Persistence layer. Owns EF Core, the DbContext, entity mappings and
    migrations. Application code only ever sees the repository interfaces it
    declares itself, so the ORM stays replaceable.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GymPro.Persistence</RootNamespace>
    <AssemblyName>GymPro.Persistence</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GymPro.Domain\GymPro.Domain.csproj" />
    <ProjectReference Include="..\GymPro.Application\GymPro.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />

    <!--
      Pinned transitive overrides. EF Core 10.0.0 still pulls these versions
      transitively and NuGet's audit flags them as vulnerable, which fails the
      build because warnings are errors here. Pin forward instead of disabling
      the audit.
    -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

</Project>