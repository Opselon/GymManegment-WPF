root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,xml,csproj,props,targets,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Namespace must match the folder, which keeps the layer boundaries visible in
# the file tree as well as in the project references.
dotnet_style_namespace_match_folder = true

# Explicit types where the type is not obvious from the right-hand side.
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Prefer modern C# forms that the codebase uses throughout.
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = when_multiline:warning
dotnet_style_prefer_collection_expression = true:suggestion
